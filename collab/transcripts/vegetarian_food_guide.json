  "serving_definitions": {
    "groups": [
      {
        "group": "全穀雜糧類",
        "page": 10,
        "unit": "1碗（碗為一般家用飯碗、重量為可食重量）",
        "equivalences": [
          "糙米飯1碗 或 雜糧飯1碗 或 米飯1碗",
          "熟麵條2碗 或 小米稀飯2碗 或 燕麥粥2碗",
          "米、大麥、小麥、蕎麥、燕麥、麥粉、麥片80公克",
          "中型芋頭4/5個(220公克) 或 小蕃薯2個(220公克)",
          "玉米2又2/3根(340公克) 或 馬鈴薯2個(360公克)",
          "全麥饅頭1又1/3個(120公克) 或 全麥吐司2片(120公克)"
        ]
      },
      {
        "group": "豆類",
        "page": 11,
        "unit": "1份（重量為可食部分生重）",
        "equivalences": [
